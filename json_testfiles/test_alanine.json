{
  "io_control": {
    "mol_from_smiles": "C[C:1](=O)[NH:2][C@@H:3](C)[C:4](=O)[NH:5]C",
    "mmff_optimize": true,
    "output_dir": "test_alanine",
    "overwrite_output_dir": true,
    "etkdvg3_seed": 1994
  },
  "unbiased_calculator": {
    "type": "tblite",
    "parameters": { "max_iterations": 1000, "accuracy": 1.0, "verbosity": 0 }
  },
  "run_control": {
    "temperature": 310.0,
    "timestep": 0.5,
    "friction": 0.2,
    "steps_between_hills": 50,
    "n_hills": 1000,
    "trajectory_write_interval": 100,
    "kernel_height": 0.1
  },
  "collective_variables": [
    {
      "type": "dihedral",
      "parameters": { "name": "phi", "indices": [[1, 2, 3, 4]] }
    },
    {
      "type": "dihedral",
      "parameters": { "name": "psi", "indices": [[2, 3, 4, 5]] }
    }
  ],
  "kernels": [
    {
      "type": "von_mises",
      "target_cvs": ["phi.1", "psi.1"],
      "parameters": { "width": 0.15 }
    }
  ],
  "additional_potentials": []
}